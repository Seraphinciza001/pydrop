<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 et plus : écran de démarrage du système, puis l'écran animé de la page -->
    <style name="PyDropTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">#38BDF8</item>
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#0D182C</item>
    </style>
</resources>
